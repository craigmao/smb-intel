# ===== Qwen API (通义千问) =====
# 阿里云百炼平台获取: https://bailian.console.aliyun.com/
QWEN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== 企业微信机器人 Webhook =====
# 在企微群 → 添加群机器人 → 复制 Webhook URL
WECOM_BOT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxxxx

# ===== 钉钉机器人 Webhook =====
# 在钉钉群 → 智能群助手 → 添加机器人 → 复制 Webhook URL
DINGTALK_BOT_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxxxxxxx
DINGTALK_BOT_SECRET=SECxxxxxxxxxxxxxxxx

# ===== 可选: 数据存储 =====
# Vercel KV (自动配置) 或 Upstash Redis
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
